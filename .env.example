ANTHROPIC_API_KEY=
TAVILY_API_KEY=

# Optional - per-node tracing (v3 step 3.9). Leave blank and the graph
# uses a null tracer; nothing needs Docker. Fill in from the project you
# create at http://localhost:3000 after `docker compose up -d`.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000
